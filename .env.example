# Copy to .env and change the password. .env is never committed.
POSTGRES_USER=talent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=talent
# Host inside the compose network ("db"); use localhost + POSTGRES_HOST_PORT from your own machine
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# shinyapps.io deployment (R/10_deploy.R) — from shinyapps.io: Account → Tokens
SHINYAPPS_ACCOUNT=
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=
